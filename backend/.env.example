# Optional: HS256 signing key (UTF-8, at least 32 bytes). If unset, a dev default is used (tokens reset on restart).
# JWT_SECRET=your-random-at-least-32-character-secret-here

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# Frontend URL used after Google login succeeds
FRONTEND_URL=http://localhost:3100

# Google Cloud OAuth redirect URI
GOOGLE_REDIRECT_URI=http://localhost:10200/login/oauth2/code/google

# Local admin account (created/updated on each backend startup). Use real values — placeholders are ignored.
ADMIN_EMAIL=irosh@gmail.com
ADMIN_PASSWORD=123456
