# Copy to backend/.env and fill in real values. Restart the backend after changes.
# Optional: HS256 signing key (UTF-8, at least 32 bytes). If unset, a dev default is used.
# JWT_SECRET=your-random-at-least-32-character-secret-here

# --- Google OAuth (required for "Continue with Google") ---
# If these are missing or still placeholders, Google shows: Error 401 invalid_client / OAuth client was not found.
#
# 1) Google Cloud Console → https://console.cloud.google.com/
# 2) APIs & Services → Credentials → Create Credentials → OAuth client ID
# 3) Application type: Web application (not Desktop / not iOS / not Android)
# 4) Authorized redirect URIs — add BOTH (match your Spring Boot port; see startup log "Uniflow API: http://..."):
#      http://localhost:10200/login/oauth2/code/google
#      http://127.0.0.1:10200/login/oauth2/code/google
#    If your app uses another port (e.g. 10205), add the same paths with that port.
# 5) OAuth consent screen: add your Google account as a test user while in "Testing" mode.
#
# Paste the real Client ID and Client Secret below. No quotes. No spaces around =.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Where the browser goes after Google login (React app)
FRONTEND_URL=http://localhost:3100

# Local admin (seeded on startup; placeholders are skipped)
ADMIN_EMAIL=your-admin@example.com
ADMIN_PASSWORD=change-me
